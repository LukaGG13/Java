<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-padding: 10;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label text="Booking Information" prefHeight="20.0">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="userLabel" text="User: " />
      <Label fx:id="roomLabel" text="Room: " />
      <Label fx:id="checkInLabel" text="Check-In: " />
      <Label fx:id="checkOutLabel" text="Check-Out: " />
   </children>
</VBox>
